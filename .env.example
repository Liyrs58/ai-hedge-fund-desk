# Research-real paper desk. No keys required.
# LIVE_TRADING is hard-false — this process cannot send live orders.
#
# LLM: NVIDIA NIM only. Mock if NVIDIA_API_KEY is unset.
#   https://build.nvidia.com/settings
#   POST https://integrate.api.nvidia.com/v1/chat/completions
#   model google/gemma-4-31b-it   (locked)
#   stream:true  timeout 180s (cold start ~2 min; non-stream can hang)
# OpenAI / Anthropic keys are ignored.
#
# Quotes: Yahoo chart API, no key. SAMPLE fallback if Yahoo is blocked.
# Book/blotter: JSON file at data/desk-store.json (or /tmp on serverless).
# Durable on Vercel: DESK_STORE=blob + Blob store token (free).

LIVE_TRADING=false
PAPER_BROKER=off

# NVIDIA_API_KEY=
# Locked (code ignores these if set to anything else):
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=google/gemma-4-31b-it

# LLM_PROVIDER=mock

# --- Durable store (Vercel Blob, free tier) ---
# DESK_STORE=blob
# BLOB_READ_WRITE_TOKEN=           # auto-set when you connect a Blob store
# DESK_STORE_PATH=data/desk-store.json

# --- Optional demo access gate (not a full IdP) ---
# Unset DEMO_ACCESS_CODE = open public demo (default).
# DEMO_ACCESS_CODE=choose-a-shared-code
# AUTH_SECRET=                     # openssl rand -base64 32
# If AUTH_SECRET is unset, the cookie is signed from DEMO_ACCESS_CODE.

# --- Alpaca PAPER broker (never live) ---
# PAPER_BROKER=alpaca
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live hosts (api.alpaca.markets) are refused. Missing keys → local simulator.
