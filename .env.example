# Optional. Leave empty / LLM_PROVIDER=mock to run the paper desk with a
# deterministic offline pipeline (no network). Required for `npm run dev`
# with zero keys.
#
# If you set a provider AND its key, POST /api/desk/run will ask the model
# to rewrite debate *language* only. Ticket size, risk verdict, and fills
# stay computed locally. A failed live call falls back to the mock bodies
# and the footer shows FALLBACK MOCK.

LLM_PROVIDER=mock

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-0

# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# XAI_API_KEY=
# XAI_MODEL=grok-3
