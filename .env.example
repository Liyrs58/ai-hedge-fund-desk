# Optional. No keys required. Default is a deterministic mock LLM and
# sample marks. LIVE_TRADING is always false — this desk cannot send
# live orders.
#
# NVIDIA NIM (free catalog, OpenAI-compatible):
#   https://build.nvidia.com/settings          → NVIDIA_API_KEY
#   https://integrate.api.nvidia.com/v1        → chat/completions
#   model meta/llama-3.1-8b-instruct           (docs.api.nvidia.com/nim)
#
# If NVIDIA_API_KEY is unset, Run desk stays fully offline (MOCK).
# If set, wording is rewritten via NIM; ticket / risk / fills stay local.
# A failed NIM call falls back to mock prose (badge FALLBACK MOCK).
#
# Yahoo last-price overlay needs no key. Bootstrap and Refresh marks
# try Yahoo; SAMPLE marks stay on the tape if Yahoo does not answer.

LIVE_TRADING=false

# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# LLM_PROVIDER=mock
